# Copy this to .env.local for local development. In production (Vercel),
# set each of these in Project Settings -> Environment Variables instead,
# nothing here is read from a committed file at runtime.

# --- Database (visits + leads) -------------------------------------------
# A Postgres connection string. Vercel Storage -> Create Database -> Neon
# (or Postgres) writes this for you automatically when connected to this
# project; for any other Postgres host, use its connection string here.
DATABASE_URL=

# --- Outbound email (Resend) ----------------------------------------------
# resend.com -> API Keys. Needs aifax.net verified as a sending domain
# (Resend -> Domains -> Add Domain -> add the DNS records it gives you)
# or sends will fail/land in spam.
RESEND_API_KEY=
RESEND_FROM="AiFax <info@aifax.net>"
# Where the contact-form notification email goes.
ADMIN_NOTIFICATION_EMAIL=info@aifax.net
# Resend -> Webhooks -> Add Endpoint -> https://www.aifax.net/api/webhooks/resend,
# subscribed to email.opened/email.clicked (and delivered/bounced/complained if
# wanted) -> copy the endpoint's signing secret here. Powers the "Opened" column
# on /admin. Also turn on open/click tracking for the domain in Resend's
# dashboard (Domains -> aifax.net), it's off by default.
RESEND_WEBHOOK_SECRET=

# --- Meta (Facebook/Instagram) Pixel + Conversions API --------------------
# Events Manager (business.facebook.com/events_manager) -> your Pixel ->
# Settings, for the Pixel ID. Conversions API -> Generate Access Token for
# the token. Both are required for the site-visitor and lead retargeting
# audiences to build correctly.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# --- CRM: Gmail sync (read-only) --------------------------------------------
# Lets the admin CRM log every inbound/outbound email with a lead into that
# lead's timeline. One-time setup: Google Cloud Console -> create a project
# under the aifax.net Workspace org -> enable the Gmail API -> OAuth consent
# screen (Internal) -> Credentials -> Create OAuth client ID (Web
# application, redirect URI https://www.aifax.net/api/gmail/oauth/callback).
# Put the resulting Client ID/Secret here, then as an admin visit
# /api/gmail/oauth/connect, approve access, and copy the refresh token it
# shows into GMAIL_REFRESH_TOKEN below. Runs on the same daily Vercel Cron
# as the nurture sender (see vercel.json).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Google Analytics 4 ----------------------------------------------------
# analytics.google.com -> Admin -> Data Streams -> your web stream ->
# Measurement ID (starts with G-).
NEXT_PUBLIC_GA4_ID=

# --- Admin dashboard (/admin) ----------------------------------------------
# Pick any strong password, this is the only credential gating /admin.
ADMIN_PASSWORD=

# --- Scheduled email sender (Vercel Cron) ----------------------------------
# Any long random string. Vercel automatically sends this as a Bearer
# token to /api/cron/nurture on its daily schedule (see vercel.json); the
# route rejects any request that doesn't present it.
CRON_SECRET=

# --- Compliance -------------------------------------------------------------
# CAN-SPAM requires a real postal address in every marketing email. Put
# the practice/company's actual mailing address here.
COMPANY_MAILING_ADDRESS=

# --- Optional / has safe defaults ------------------------------------------
# Used to build unsubscribe links; defaults to https://www.aifax.net.
NEXT_PUBLIC_SITE_URL=https://www.aifax.net
# Salt used to one-way hash visitor IPs before storing them (never raw
# IPs). Any random string; changing it just rotates old hashes.
IP_HASH_SALT=
# Secret used to sign unsubscribe links. Falls back to IP_HASH_SALT if unset.
UNSUBSCRIBE_SECRET=
# Comma-separated IPs that never count as a site visit, e.g. the owner's
# own connection. Optional; a residential IP can change over time, so
# this may need updating later. Example: 99.106.29.57
EXCLUDED_VISITOR_IPS=
